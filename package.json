{
  "name": "shellspan",
  "private": true,
  "version": "2.0.56",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "prebuild": "pnpm electron:compile",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:desktop": "pnpm electron:compile && node --test dist-electron/tests/*.test.js",
    "test:native": "cargo test --manifest-path native/Cargo.toml --lib",
    "test:desktop:smoke": "pnpm native:build && pnpm build && node scripts/native-smoke.ts && node scripts/electron-smoke.ts",
    "test:e2e:ssh": "node scripts/run-ssh-e2e.mjs",
    "check:desktop": "pnpm electron:compile && node scripts/check-desktop-contract.cjs",
    "native:build": "cargo build --manifest-path native/Cargo.toml",
    "native:release": "cargo build --release --manifest-path native/Cargo.toml",
    "electron:dev": "pnpm electron:compile && node scripts/electron-dev.ts",
    "electron:start": "pnpm electron:compile && electron .",
    "electron:build": "pnpm build && pnpm native:release && electron-builder --publish never",
    "electron:pack": "pnpm build && pnpm native:release && electron-builder --dir --publish never",
    "version": "node scripts/bump-version.mjs",
    "electron:compile": "node electron/build.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@lexical/history": "^0.50.0",
    "@lexical/plain-text": "^0.50.0",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "lexical": "^0.50.0",
    "lucide-react": "^1.27.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl-universal": "^2.14.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "^6.0.4",
    "ajv": "^8.20.0",
    "code-inspector-plugin": "^1.6.6",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "git-cliff": "^2.13.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.1.1",
  "main": "dist-electron/main.js"
}
